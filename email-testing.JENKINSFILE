pipeline {
    agent any

    triggers {
        // 08:00 IST on day 1 and day 15 of every month
        cron('TZ=Asia/Kolkata\n0 8 1,15 * *')
    }

    options {
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '12'))
    }

    environment {
        DB_HOST     = 'postgres-europe.postgres.database.azure.com'
        DB_NAME     = 'mdo-profile'
        // Use IST so the date matches the schedule regardless of controller timezone
        REPORT_DATE = "${new Date().format('yyyy-MM-dd', TimeZone.getTimeZone('Asia/Kolkata'))}"
        OUT         = "aarti_user_roles_${REPORT_DATE}.csv"
    }

    stages {
        stage('Export') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'AARTI_REPORT_DB',
                                                  usernameVariable: 'DB_USER',
                                                  passwordVariable: 'PGPASSWORD')]) {
                    sh '''
                        set -e
                        command -v psql >/dev/null || { echo "psql is not installed on this agent"; exit 1; }
                        export PGSSLMODE=require
                        psql -h "$DB_HOST" -U "$DB_USER" -d "$DB_NAME" \
                             -v ON_ERROR_STOP=1 --csv -c '
                            SELECT p.userid, p.fname, p.lname, p.pemail, p.status,
                                   r.roleid, r.description
                            FROM "809086".role_description r
                            JOIN "809086".user_roles f ON r.roleid = f.roleid
                            JOIN "809086".user_personal_details p ON f.userid = p.username
                            ORDER BY p.userid
                        ' > "$OUT"
                        wc -l "$OUT"
                    '''
                }
            }
        }
    }

    post {
        always {
            // Keep a copy even if the email fails
            archiveArtifacts artifacts: "${env.OUT}", allowEmptyArchive: true
        }
        success {
            emailext(
                to: 'akashsikarwar2211@gmail.com',
                subject: "Aarti Industries - User and role report (${env.REPORT_DATE})",
                body: 'Hello,\n\nPlease find the user and role report attached.\n\nRegards,\nProspecta Support',
                attachmentsPattern: "${env.OUT}"
            )
        }
        failure {
            emailext(
                to: 'akashsikarwar2211@gmail.com',
                subject: "FAILED: Aarti report job #${env.BUILD_NUMBER}",
                body: "The scheduled report failed. See ${env.BUILD_URL}"
            )
        }
    }
}
